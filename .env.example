# Robust Testing Solutions — serverless enquiry configuration
# Copy to your Vercel Project → Settings → Environment Variables.
# Until these are set, /api/contact and /api/quote return HTTP 503 and the
# forms honestly tell the user nothing was sent (no fake success).

# Resend API key (https://resend.com). Required to send email.
RESEND_API_KEY=

# Verified sender, e.g. "Robust Website <noreply@robustsolutions.in>". Required.
CONTACT_FROM=

# Destination inbox. Optional; defaults to info@robustsolutions.in.
CONTACT_TO=info@robustsolutions.in
